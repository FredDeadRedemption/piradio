# copy to .env and edit. every value here is optional; the defaults run a working station.

# what the station calls itself, on the player and in the icecast metadata
WEBRADIO_NAME=webradio
WEBRADIO_DESCRIPTION=a small internet radio station

# set this. without it the control interface is open to anyone who can reach it.
WEBRADIO_PASSWORD=

# the timezone the schedule is written in
WEBRADIO_TZ=UTC

# host ports: the station, and the control interface
WEBRADIO_PORT=8000
WEBRADIO_ADMIN_PORT=8080

WEBRADIO_BITRATE=128
WEBRADIO_MAX_LISTENERS=100
WEBRADIO_MAX_UPLOAD_MB=300
# uploads stop before the disk fills
WEBRADIO_MIN_FREE_MB=512

# only reachable inside the compose network, but change them anyway if you publish icecast
ICECAST_SOURCE_PASSWORD=source
ICECAST_ADMIN_PASSWORD=admin
ICECAST_RELAY_PASSWORD=relay
ICECAST_MOUNT=/radio.mp3
