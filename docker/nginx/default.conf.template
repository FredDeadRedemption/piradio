# two doors: 80 is the station, 8080 is the control room. icecast is on neither.

limit_conn_zone $binary_remote_addr zone=webradio_conn:10m;
limit_req_zone  $binary_remote_addr zone=webradio_ui:10m rate=10r/s;

# the compose network hands out new addresses on every recreate, so resolve per request
resolver 127.0.0.11 ipv6=off valid=30s;

server {
    listen 80 default_server;
    server_name _;
    server_tokens off;

    include /etc/nginx/conf.d/stream.inc;

    # read-only: the player, its assets, and the one status endpoint it polls
    location ^~ /listen/ {
        set $api api:8080;
        proxy_pass http://$api;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /api/now {
        set $api api:8080;
        proxy_pass http://$api;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = / {
        set $api api:8080;
        proxy_pass http://$api/listen/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        return 404;
    }
}

server {
    listen 8080;
    server_name _;
    server_tokens off;

    # the control page embeds the player, so the mount answers on this door too
    include /etc/nginx/conf.d/stream.inc;

    location / {
        limit_req zone=webradio_ui burst=20 nodelay;
        client_max_body_size ${WEBRADIO_MAX_UPLOAD_MB}m;

        set $api api:8080;
        proxy_pass http://$api;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # large uploads stream straight through rather than landing in a temp file first
        proxy_request_buffering off;
        proxy_read_timeout 10m;
        proxy_send_timeout 10m;
    }
}
